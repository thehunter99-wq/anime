# Canonical site origin. Used for canonical tags, OpenGraph `og:url`, the
# sitemap, robots.txt and JSON-LD. No trailing slash. Defaults to the value in
# src/lib/site.ts if unset — set it explicitly in your host's env settings so a
# domain change needs no code deploy.
NEXT_PUBLIC_SITE_URL=https://movanime.site

# TMDB API key — https://www.themoviedb.org/settings/api
# Do not commit a live key here. Copy this file to .env.local, paste your own
# key, and set the same variable in your deployment provider's env settings.
NEXT_PUBLIC_TMDB_API_KEY=

# Google Analytics 4 measurement ID (optional). Defaults to G-7S0357K6TW when unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Adsterra zone key — https://adsterra.com/dashboard
# Required for the in-content AdBanner slots.
NEXT_PUBLIC_ADSTERRA_KEY=

# Adsterra Social Bar (sticky overlay). Renders without any other key set.
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_URL=https://pl31625876.profitableratecpmnetwork.com/77/43/d2/7743d209f9e5ab47329ac706ebe9fa56.js

# Adsterra Popunder. Loads only in production builds — Adsterra drops
# traffic from localhost and unverified origins.
NEXT_PUBLIC_ADSTERRA_POPUNDER_URL=https://pl31625875.profitableratecpmnetwork.com/be/f0/3c/bef03cbd6a8d7712fde3e921125ecc00.js

# Adsterra Smartlink behind the primary "Fast HD Download" button on movie and
# TV pages. The secondary "Direct Server" button bypasses it.
NEXT_PUBLIC_ADSTERRA_SMARTLINK_URL=https://www.profitableratecpmnetwork.com/tguhgg4ee?key=b0ad7e27ed01791677110762cfb5d058

# Adsterra Native Banner, rendered above the footer on every page.
# SINGLETON: the loader binds to the first element whose id is
# `container-<hash>`, so this zone may only be mounted once per page.
NEXT_PUBLIC_ADSTERRA_NATIVE_BANNER_URL=https://pl31625878.profitableratecpmnetwork.com/89898e7af070f78c4da937a6a83f13c7/invoke.js

# Direct Link shown by the player overlay on the watch page.
# Leave EMPTY to disable the overlay entirely — the player then behaves exactly
# as if no monetisation were present.
# Paste your Adsterra "Direct Link" or PropellerAds Direct Link URL here.
# Trigger frequency is capped at 3 per 10 minutes per browser; once spent the
# overlay stays hidden. Tune in src/config/ads.ts (DIRECT_LINK_CAP).
NEXT_PUBLIC_ADSTERRA_DIRECT_LINK_URL=
